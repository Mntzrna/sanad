# Sanad image parameters (read by the Justfile and the GitHub workflows)

# Must equal the GitHub repository name (the workflows use the repo name).
IMAGE_NAME=sanad

# Your GitHub username / organisation. Set by ./setup.sh.
REPO_ORGANIZATION="CHANGE-ME"

IMAGE_DESC="Sanad - gaming-focused Linux, based on Bazzite (Universal Blue)"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,bazzite,sanad"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/CHANGE-ME/sanad/main/system_files/usr/share/pixmaps/sanad.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
